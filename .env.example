# ReverseIt environment configuration
# Copy to .env for local development: cp .env.example .env
# Never commit a real .env or any API key.

APP_NAME=ReverseIt
ENVIRONMENT=development
LOG_LEVEL=info

# Local SQLite database. Cases contain only the last four digits of an account.
DATABASE_URL=sqlite:///./reverseit.db

# Backend port (uvicorn).
PORT=8000

# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# Groq (alert parsing fallback and screenshot text extraction)
# ------------------------------------------------------------------------------
# Required for the LLM fallback and for screenshots. Without it, rule-based
# parsing still runs for pasted text. Never commit a key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Keep these small: the free tier limits output tokens per minute.
GROQ_MAX_TOKENS=400
GROQ_IMAGE_MAX_TOKENS=300

# Optional, only if your model supports it (for example "none").
GROQ_REASONING_EFFORT=

# ------------------------------------------------------------------------------
# Frontend (Vite reads variables prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
